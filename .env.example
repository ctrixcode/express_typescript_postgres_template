# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DB_USERNAME=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbname
DB_SSL=false

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Security (Set strong, unique 32+ character secrets in production)
JWT_ACCESS_TOKEN_SECRET=dev_only_super_secret_access_jwt_key_32chars!
JWT_REFRESH_TOKEN_SECRET=dev_only_super_secret_refresh_jwt_key_32chars!
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Optional: Logging & Documentation
LOG_LEVEL=info
ENABLE_SWAGGER=true